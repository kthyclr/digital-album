# Environment Configuration Example (Placeholder Values Only)
# Do NOT commit real secrets or service account private keys to Git.

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Optional Vite public Firebase overrides (if not using firebase-applet-config.json)
# Note: Public Firebase Web SDK settings identify the project and are governed by
# Firestore & Storage Security Rules—never put Firebase Admin SDK private keys here.
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_PUBLIC_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_APP_ID="1:000000000000:web:000000000000"
VITE_FIRESTORE_DATABASE_ID="your-firestore-database-id"
