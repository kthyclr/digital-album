# Environment Configuration Example (Placeholder Values Only)
# Do NOT commit real secrets or service account private keys to Git.

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Optional Vite public Firebase overrides (if not using firebase-applet-config.json)
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_PUBLIC_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_APP_ID="1:000000000000:web:000000000000"
VITE_FIRESTORE_DATABASE_ID="your-firestore-database-id"

# Optional Supabase Storage configuration (for storing original full-res photos, videos & audio on Supabase Free Tier)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-public-key"
VITE_SUPABASE_BUCKET="memories"
